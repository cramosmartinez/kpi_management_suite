<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_template_action" model="ir.actions.act_window">
        <field name="name">Plantillas de KPI</field>
        <field name="res_model">kpi.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="kpi_evaluation_week_tree_view" model="ir.ui.view">
        <field name="name">kpi.evaluation.week.tree</field>
        <field name="model">kpi.evaluation.week</field>
        <field name="arch" type="xml">
            <tree string="Evaluaciones" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="final_average" widget="percentage"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="kpi_evaluation_week_form_view" model="ir.ui.view">
        <field name="name">kpi.evaluation.week.form</field>
        <field name="model">kpi.evaluation.week</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_kpi_templates" string="Cargar KPIs" type="object" class="oe_highlight" invisible="state!='draft' or line_ids"/>
                    <button name="action_validate" string="Validar" type="object" class="oe_highlight" invisible="state!='draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><field name="employee_id"/><field name="date_start"/></group>
                    <notebook>
                        <page string="Métricas"><field name="line_ids"><tree editable="bottom"><field name="kpi_id"/><field name="score_monday"/><field name="score_tuesday"/><field name="score_wednesday"/><field name="score_thursday"/><field name="score_friday"/><field name="weekly_average" widget="percentage"/></tree></field></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_evaluation_week_action" model="ir.actions.act_window">
        <field name="name">Evaluación Semanal</field>
        <field name="res_model">kpi.evaluation.week</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <record id="kpi_admin_task_form_view" model="ir.ui.view">
        <field name="name">kpi.admin.task.form</field>
        <field name="model">kpi.admin.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="alert alert-info shadow-sm p-2 mb-3" role="alert">
                        <strong>Calidad (1-10):</strong> 
                        <span class="badge text-bg-danger ms-2">1-3 Bajo</span>
                        <span class="badge text-bg-warning ms-2">4-6 Medio</span>
                        <span class="badge text-bg-success ms-2">7-8 Bueno</span>
                        <span class="badge text-bg-primary ms-2">9-10 Excelente</span>
                    </div>

                    <div class="oe_title"><h1><field name="name" placeholder="Título de la Tarea"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="task_type"/>
                        </group>
                        <group>
                            <field name="score" widget="integer"/>
                            <field name="date_deadline"/>
                            <field name="color" widget="color_picker" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    
    <record id="kpi_admin_task_kanban_view" model="ir.ui.view">
        <field name="name">kpi.admin.task.kanban</field>
        <field name="model">kpi.admin.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="color"/><field name="name"/><field name="employee_id"/><field name="score"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click {{ record.color.raw_value ? 'o_kanban_color_' + record.color.raw_value : '' }}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="employee_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge rounded-pill text-bg-dark" t-if="record.score.raw_value > 0">
                                        <field name="score"/>/10
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kpi_admin_task_action" model="ir.actions.act_window">
        <field name="name">Tareas y Proyectos</field>
        <field name="res_model">kpi.admin.task</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
    </record>

    <record id="kpi_course_tracking_action" model="ir.actions.act_window">
        <field name="name">Certificaciones</field>
        <field name="res_model">kpi.course.tracking</field>
        <field name="view_mode">tree,form,graph</field>
    </record>
</odoo>