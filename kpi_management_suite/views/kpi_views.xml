<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kpi_template_tree_view" model="ir.ui.view">
        <field name="name">kpi.template.tree</field>
        <field name="model">kpi.template</field>
        <field name="arch" type="xml">
            <tree string="KPI Templates">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="kpi_template_form_view" model="ir.ui.view">
        <field name="name">kpi.template.form</field>
        <field name="model">kpi.template</field>
        <field name="arch" type="xml">
            <form string="KPI Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group><field name="name"/><field name="active"/></group>
                    </group>
                    <group string="Grading Manual">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_template_action" model="ir.actions.act_window">
        <field name="name">KPI Templates</field>
        <field name="res_model">kpi.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="kpi_evaluation_week_tree_view" model="ir.ui.view">
        <field name="name">kpi.evaluation.week.tree</field>
        <field name="model">kpi.evaluation.week</field>
        <field name="arch" type="xml">
            <tree string="Weekly Evaluations" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="final_average" widget="percentage" string="Score"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="kpi_evaluation_week_form_view" model="ir.ui.view">
        <field name="name">kpi.evaluation.week.form</field>
        <field name="model">kpi.evaluation.week</field>
        <field name="arch" type="xml">
            <form string="Weekly Evaluation Sheet">
                <header>
                    <button name="action_load_kpi_templates" string="Load KPIs" type="object" class="oe_highlight" invisible="state != 'draft' or line_ids"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'done'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ['done', 'cancel']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="employee_id"/><field name="date_start"/></group>
                        <group><field name="date_end"/></group>
                    </group>
                    <notebook>
                        <page string="Evaluation Metrics">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="kpi_id" readonly="1"/>
                                    <field name="score_monday"/>
                                    <field name="score_tuesday"/>
                                    <field name="score_wednesday"/>
                                    <field name="score_thursday"/>
                                    <field name="score_friday"/>
                                    <field name="weekly_average" widget="percentage" readonly="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="final_average" widget="percentage" string="Final Average"/>
                            </group>
                        </page>
                    </notebook>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                        <field name="activity_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_evaluation_week_action" model="ir.actions.act_window">
        <field name="name">Weekly Evaluations</field>
        <field name="res_model">kpi.evaluation.week</field>
        <field name="view_mode">tree,form,graph,pivot</field>
    </record>

    <record id="kpi_admin_task_tree_view" model="ir.ui.view">
        <field name="name">kpi.admin.task.tree</field>
        <field name="model">kpi.admin.task</field>
        <field name="arch" type="xml">
            <tree string="Tasks" decoration-success="state == 'complete'" decoration-danger="state == 'overdue'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="task_type"/>
                <field name="date_deadline"/>
                <field name="state"/>
                <field name="score" string="Score (1-10)"/>
            </tree>
        </field>
    </record>

    <record id="kpi_admin_task_form_view" model="ir.ui.view">
        <field name="name">kpi.admin.task.form</field>
        <field name="model">kpi.admin.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress_int,complete,overdue" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="alert alert-info shadow-sm p-3 mb-4" role="alert">
                        <h4 class="alert-heading" style="font-size: 1.1em; font-weight: 600;">Quality Score (Scale 1 to 10)</h4>
                        <ul style="list-style: none; padding: 0; margin-top: 5px; display: flex; justify-content: space-around;">
                            <li style="flex: 1; text-align: center;"><span class="badge text-bg-danger p-2" style="background-color: #dc3545 !important; color: white;">1-3 Low</span></li>
                            <li style="flex: 1; text-align: center;"><span class="badge text-bg-warning p-2" style="background-color: #ffc107 !important;">4-6 Medium</span></li>
                            <li style="flex: 1; text-align: center;"><span class="badge text-bg-success p-2" style="background-color: #198754 !important; color: white;">7-8 Good</span></li>
                            <li style="flex: 1; text-align: center;"><span class="badge text-bg-primary p-2" style="background-color: #0d6efd !important; color: white;">9-10 Excellent</span></li>
                        </ul>
                    </div>
                    
                    <div class="oe_title"><h1><field name="name" placeholder="Task Title..."/></h1></div>
                    
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="task_type"/>
                        </group>
                        <group>
                            <field name="score" widget="integer" string="Final Score (1-10)"/>
                            <field name="score_percentage" invisible="1"/>
                            <field name="color" widget="color_picker" invisible="1"/>
                        </group>
                    </group>
                    <group string="Tracking Dates"><field name="date_assigned"/><field name="date_deadline"/><field name="date_completed"/></group>
                    <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/><field name="activity_ids"/></div>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="kpi_admin_task_kanban_view" model="ir.ui.view">
        <field name="name">kpi.admin.task.kanban</field>
        <field name="model">kpi.admin.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/><field name="color"/><field name="score"/><field name="name"/><field name="employee_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click {{ record.color.raw_value ? 'o_kanban_color_' + record.color.raw_value : '' }}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings"><strong class="o_kanban_record_title"><field name="name"/></strong></div>
                            </div>
                            <div class="o_kanban_record_body"><field name="employee_id"/></div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge rounded-pill text-bg-dark" t-if="record.score.raw_value > 0"><field name="score"/>/10</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kpi_admin_task_action" model="ir.actions.act_window">
        <field name="name">Tasks &amp; Projects</field>
        <field name="res_model">kpi.admin.task</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <record id="kpi_course_tracking_form_view" model="ir.ui.view">
        <field name="name">kpi.course.tracking.form</field>
        <field name="model">kpi.course.tracking</field>
        <field name="arch" type="xml">
            <form string="Certification">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="on_track,late,at_risk"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Course Name..."/></h1></div>
                    <group>
                        <group><field name="employee_id"/></group>
                        <group><field name="total_progress_percentage" widget="percentpie" string="Current Progress"/></group>
                    </group>
                    <notebook>
                        <page string="Progress Log">
                            <field name="log_ids">
                                <tree editable="bottom">
                                    <field name="date_log"/>
                                    <field name="progress_percentage" string="% Reported"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>

    <record id="kpi_course_tracking_tree_view" model="ir.ui.view">
        <field name="name">kpi.course.tracking.tree</field>
        <field name="model">kpi.course.tracking</field>
        <field name="arch" type="xml">
            <tree string="Courses" decoration-success="state == 'on_track'" decoration-warning="state == 'late'" decoration-danger="state == 'at_risk'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="total_progress_percentage" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'on_track'" decoration-warning="state == 'late'" decoration-danger="state == 'at_risk'"/>
            </tree>
        </field>
    </record>

    <record id="kpi_course_tracking_kanban_view" model="ir.ui.view">
        <field name="name">kpi.course.tracking.kanban</field>
        <field name="model">kpi.course.tracking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/><field name="total_progress_percentage"/><field name="name"/><field name="employee_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card {{ record.state.raw_value == 'on_track' ? 'border-success' : '' }} {{ record.state.raw_value == 'late' ? 'border-warning' : '' }} {{ record.state.raw_value == 'at_risk' ? 'border-danger' : '' }}">
                            <div class="o_kanban_record_top"><strong><field name="name"/></strong></div>
                            <div class="o_kanban_record_body mt-2">
                                <field name="employee_id"/><br/>
                                <field name="total_progress_percentage" widget="progressbar"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kpi_course_tracking_action" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">kpi.course.tracking</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
    </record>

</odoo>